---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "format");
if (!page) {
  throw new Error("Format content was not found.");
}
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.summary}>
  <article class="page">
    <header class="page-header">
      <h1 class="page-title">{page.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
