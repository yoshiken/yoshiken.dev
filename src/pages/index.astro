---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "yoshikenがプログラミングや日記、ポエムを書いていくページです。";
const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  dateStyle: "medium",
  timeZone: "Asia/Tokyo",
});
---

<BaseLayout title="yoshiken.dev" description={description}>
  <section class="page" aria-label="記事一覧">
    <ol class="article-list">
      {articles.map((article) => (
        <li>
          <time datetime={article.data.date.toISOString()}>
            {dateFormatter.format(article.data.date)}
          </time>
          <a href={`/articles/${article.id}`}>{article.data.title}</a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
